APP_URL=http://localhost:3000
# Admin is derived automatically: https://example.com -> https://admin.example.com.
# Set APP_URL before building; redeploy or restart pnpm dev after changing it.
# Local admin is http://admin.localhost:3000; IPs/Vercel preview URLs use /admin.
# Local Google callback: http://localhost:3000/api/auth/callback/google.
# Sentry: public project DSN enables browser/server errors and sampled traces.
NEXT_PUBLIC_SENTRY_DSN=https://e4144503183d73035a19444b3dfb80b5@o4510285202718720.ingest.de.sentry.io/4512106068050000
# Build-only credentials for source maps; the auth token stays secret.
SENTRY_ORG=personal-a22p
SENTRY_PROJECT=canopy
SENTRY_AUTH_TOKEN=
# Required at runtime.
# With Supabase, use a pooler URL reachable from the container.
DATABASE_URL=
# Maximum connections per Node/container instance; defaults to 3. Use a positive integer.
DATABASE_POOL_MAX=3
# Application cache reads: blank defaults off in development and on elsewhere.
# Set true to enable locally, or false to force fresh reads in any environment.
# Covers the in-memory catalog and Redis reads; Redis writes/invalidation still run.
CACHE_ENABLED=
# Optional server-side Redis cache via node-redis. Leave REDIS_URL empty to disable.
# Use a separate Redis database per environment. Never use NEXT_PUBLIC_ credentials.
# Reads fall back to the database during outages; failed user/role invalidation blocks writes.
# User profiles cache for 1 hour, roles/catalog for 24 hours, ecosystem for 5 minutes.
# App mutations and admin:promote invalidate caches; direct SQL edits require invalidation.
# Supports redis:// and TLS rediss:// URLs with credentials and an optional /database.
REDIS_URL=

# Bearer secret for the internal cron endpoints (blog publish-due, assistant maintenance).
# Coolify Scheduled Tasks call them from inside the container; see README "Scheduled jobs".
SCHEDULER_SECRET=
# Optional, disposable PostgreSQL database for opt-in blog integration tests only.
BLOG_TEST_DATABASE_URL=

# Optional disposable PostgreSQL database for Assistant integration/migration tests only.
ASSISTANT_TEST_DATABASE_URL=

# Authentication and account email.
BETTER_AUTH_SECRET=
# Shared by authentication and the request proxy; blank keeps the smarttools prefix.
AUTH_COOKIE_PREFIX=smarttools
# Encrypts API keys saved from Admin -> Settings (32+ characters, e.g. `openssl rand -base64 48`).
# Without it, keys can only come from this file. Changing it makes saved keys unreadable; re-enter them.
SETTINGS_ENCRYPTION_KEY=

# Default outbound email provider: cloudflare, resend or smtp. Admin -> Settings -> Email can
# store credentials for each and switch the active one without a redeploy.
EMAIL_PROVIDER=cloudflare
# Cloudflare Email Sending: onboard the ACCOUNTS_EMAIL domain using Cloudflare DNS.
# Account ID that owns Email Sending.
CLOUDFLARE_EMAIL_ACCOUNT_ID=
# Account-scoped Email Sending: Edit token. Keep it in runtime secrets, not Build Variables.
CLOUDFLARE_EMAIL_API_TOKEN=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Google Analytics (G-...); requires visitor opt-in.
GA_MEASUREMENT_ID=
# Temporarily enable real analytics and the consent banner during local development.
GA_ENABLE_IN_DEVELOPMENT=false

# Optional integrations and public contact information.
AHREFS_API_KEY=
GEMINI_API_KEY=
SUPPORT_EMAIL=support@smarttools.lol
ACCOUNTS_EMAIL=accounts@smarttools.lol

# Tool icon and blog image uploads and public delivery.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Application-wide AI provider (openai or anthropic). Enable after configuring the API key.
# Admin -> Settings -> AI can store keys and models for each and switch the active one.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-terra
OPENAI_API_KEY=

# Optional lightweight model for brief titles; defaults to OPENAI_MODEL.
AI_TITLE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TITLE_MODEL=claude-haiku-5-5
# OpenAI-compatible endpoint (AI_PROVIDER=compatible): OpenRouter, Groq, vLLM, Ollama...
# API key is optional for endpoints that need none.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TITLE_MODEL=

# Online compilers: run user code on a self-hosted Piston engine. Fails closed when unset.
# CODE_EXECUTION_ENABLED must be "true"; CODE_EXECUTION_MAX_CONCURRENT defaults to 8.
CODE_EXECUTION_ENABLED=
PISTON_URL=
PISTON_API_TOKEN=
CODE_EXECUTION_MAX_CONCURRENT=
