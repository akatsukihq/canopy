{
  "name": "canopy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare:vendor": "node scripts/copy-media-vendor.mjs",
    "dev": "pnpm run prepare:vendor && next dev -p 3000",
    "db:migrate": "node db/scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:copy": "node db/scripts/copy-database.mjs",
    "db:translations": "node db/scripts/tool-translations.mjs",
    "tool:new": "canopy tool new",
    "tool:sql": "canopy tool sql",
    "admin:promote": "node db/scripts/promote-admin.mjs",
    "build": "pnpm run prepare:vendor && tsc --noEmit && next build --webpack",
    "build:cloudflare": "node scripts/cloudflare.mjs build",
    "preview": "node scripts/cloudflare.mjs local",
    "deploy:preview": "node scripts/cloudflare.mjs preview",
    "deploy": "node scripts/cloudflare.mjs deploy",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "lint:worker": "tsc --noEmit -p tsconfig.worker.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=UTC node --max-old-space-size=768 node_modules/vitest/vitest.mjs run",
    "test:affected": "TZ=UTC node --max-old-space-size=768 node_modules/vitest/vitest.mjs run --changed",
    "test:watch": "TZ=UTC node --max-old-space-size=768 node_modules/vitest/vitest.mjs",
    "test:media": "vitest run --coverage --coverage.include='lib/tool-framework/media/**/*.{ts,mts,mjs}' --coverage.thresholds.lines=80 --coverage.thresholds.branches=80 tests/media-*.test.mjs",
    "test:integration": "CANOPY_INTEGRATION=1 vitest run tests/*integration.test.mjs",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
